# Copy this file to .env and fill in real values before running docker compose.
# Nothing here is required to be a paid/external service - see README.md.

# --- Database ---
DB_NAME=creatoros
DB_USERNAME=creatoros
DB_PASSWORD=change-me

# --- Auth ---
# Must be at least 32 characters (HS256 requirement). Generate with e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TTL_MINUTES=60

# AES-256 key used to encrypt social account access/refresh tokens at rest.
# Any string works (it is SHA-256-hashed into a 256-bit key) - generate with `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=change-me-to-a-random-encryption-key

# --- CORS / frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# --- Sync scheduler ---
SYNC_INTERVAL_MS=900000
SYNC_STALE_AFTER_MINUTES=60
SYNC_EXECUTOR_CORE_POOL_SIZE=4
SYNC_EXECUTOR_MAX_POOL_SIZE=8
SYNC_EXECUTOR_QUEUE_CAPACITY=100
SYNC_RETRY_MAX_ATTEMPTS=3
SYNC_RETRY_INITIAL_BACKOFF_MS=1000
SYNC_RETRY_BACKOFF_MULTIPLIER=2.0

# --- AI (optional - the app runs fully without these; see docs/ai-and-mcp.md) ---
# AI_PROVIDER: none | openai | anthropic
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- YouTube Data API (optional - only needed to connect real YouTube accounts) ---
# Create a key at https://console.cloud.google.com/apis/credentials with the YouTube Data API v3 enabled.
YOUTUBE_API_KEY=
# Reserved for a future OAuth flow (private/owner-only metrics); not required for public-data reads.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
